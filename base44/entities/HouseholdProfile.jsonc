{
  "name": "HouseholdProfile",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "guest_email": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_phone": {
      "type": "string"
    },
    "membership_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "past_due",
        "cancelled",
        "paused"
      ],
      "default": "none"
    },
    "membership_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "saved_addresses": {
      "type": "string",
      "description": "Newline-separated addresses. Multiple addresses allowed."
    },
    "primary_service_address": {
      "type": "string"
    },
    "service_area_status": {
      "type": "string",
      "enum": [
        "inside_area",
        "outside_area",
        "manual_review"
      ]
    },
    "property_type": {
      "type": "string",
      "enum": [
        "House",
        "Apartment",
        "Condo",
        "Townhome",
        "Senior Community",
        "Other"
      ]
    },
    "household_size": {
      "type": "string",
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5+"
      ]
    },
    "children_present": {
      "type": "string",
      "enum": [
        "None",
        "Infant",
        "Toddler",
        "School Age",
        "Teen",
        "Multiple ages"
      ]
    },
    "children_notes": {
      "type": "string"
    },
    "seniors_present": {
      "type": "boolean",
      "default": false
    },
    "senior_notes": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "mobility_concerns": {
      "type": "boolean",
      "default": false
    },
    "mobility_notes": {
      "type": "string"
    },
    "pets": {
      "type": "string",
      "description": "Pet names, types, behavior notes"
    },
    "access_notes": {
      "type": "string",
      "description": "Gate code, parking, entry instructions"
    },
    "parking_notes": {
      "type": "string"
    },
    "provider_safe_notes": {
      "type": "string",
      "description": "Notes that can safely show to assigned providers"
    },
    "supply_preferences": {
      "type": "string",
      "description": "Fragrance-free, no bleach, etc."
    },
    "supply_status": {
      "type": "string",
      "enum": [
        "guest_supplies_ready",
        "needs_supply_check",
        "provider_bring_basic_kit",
        "shopping_required"
      ]
    },
    "laundry_preferences": {
      "type": "string"
    },
    "shoe_policy": {
      "type": "boolean",
      "default": false,
      "description": "Shoes off requested"
    },
    "future_todo_list": {
      "type": "string",
      "description": "Things I'd Love Help With — future wish list for upcoming visits"
    },
    "preferred_provider": {
      "type": "string",
      "description": "Preferred provider name/ID"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "Text",
        "Email",
        "Phone call"
      ]
    },
    "sms_opt_in": {
      "type": "boolean",
      "default": false
    },
    "email_opt_in": {
      "type": "boolean",
      "default": true
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "Google",
        "Instagram",
        "Facebook",
        "Referral",
        "Event",
        "Flyer",
        "School",
        "Other"
      ]
    },
    "referral_code": {
      "type": "string",
      "description": "This client's unique referral code (e.g. MASHA25)"
    },
    "referral_credits_available": {
      "type": "number",
      "default": 0,
      "description": "Total $25 credits available to use on next service"
    },
    "referral_credits_used": {
      "type": "number",
      "default": 0,
      "description": "Total credits that have been applied to bookings"
    },
    "successful_referrals": {
      "type": "number",
      "default": 0,
      "description": "Count of completed referrals that earned a credit"
    },
    "lifetime_revenue": {
      "type": "number",
      "default": 0
    },
    "last_booking_date": {
      "type": "string",
      "format": "date"
    },
    "booking_count": {
      "type": "number",
      "default": 0
    },
    "cancelled_booking_count": {
      "type": "number",
      "default": 0
    },
    "no_show_count": {
      "type": "number",
      "default": 0
    },
    "private_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin-only caution or preference flags"
    },
    "internal_notes": {
      "type": "string",
      "description": "CEO/Admin only — never shown to client"
    }
  },
  "required": [
    "guest_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
