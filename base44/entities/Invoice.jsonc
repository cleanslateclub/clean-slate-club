{
  "name": "Invoice",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "booking_id": { "type": "string" },
    "household_profile_id": { "type": "string" },
    "client_name": { "type": "string" },
    "client_email": { "type": "string" },
    "service_label": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "sent", "paid", "void", "refunded", "failed"],
      "default": "draft"
    },
    "line_items": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "subtotal_cents": { "type": "number", "default": 0 },
    "deposit_cents": { "type": "number", "default": 0 },
    "discount_cents": { "type": "number", "default": 0 },
    "tip_cents": { "type": "number", "default": 0 },
    "total_cents": { "type": "number", "default": 0 },
    "amount_paid_cents": { "type": "number", "default": 0 },
    "balance_due_cents": { "type": "number", "default": 0 },
    "sent_at": { "type": "string", "format": "date-time" },
    "paid_at": { "type": "string", "format": "date-time" },
    "due_date": { "type": "string", "format": "date" },
    "admin_notes": { "type": "string" }
  },
  "required": ["client_name", "client_email", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.client_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
