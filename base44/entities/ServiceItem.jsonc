{
  "name": "ServiceItem",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "service",
        "package",
        "addon",
        "appt_template"
      ],
      "description": "Category of item"
    },
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price_low": {
      "type": "number"
    },
    "price_high": {
      "type": "number"
    },
    "price_display": {
      "type": "string",
      "description": "e.g. '+$45' or 'Quoted'"
    },
    "duration_minutes": {
      "type": "number"
    },
    "duration_display": {
      "type": "string",
      "description": "e.g. '2-4 hrs'"
    },
    "color": {
      "type": "string"
    },
    "service_category": {
      "type": "string",
      "description": "Which parent service this addon belongs to"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "online_booking_enabled": {
      "type": "boolean",
      "default": true
    },
    "member_only": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}