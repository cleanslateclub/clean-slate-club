{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique setting key, e.g. 'booking_enabled'"
    },
    "value": {
      "type": "string",
      "description": "The setting value (stored as string, parsed as needed)"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "feature_toggles",
        "booking_constraints",
        "territory",
        "notifications",
        "payments",
        "services"
      ],
      "default": "feature_toggles"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "boolean",
        "number",
        "string",
        "json"
      ],
      "default": "boolean"
    }
  },
  "required": [
    "key",
    "value",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
