{
  "name": "TimeBlock",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "booking",
        "travel",
        "prep",
        "wrap",
        "manual_block",
        "provider_unavailable",
        "admin_hold",
        "consult",
        "holiday_blackout",
        "premium_holiday",
        "waitlist_hold"
      ],
      "default": "booking"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "tentative",
        "held",
        "cancelled",
        "completed"
      ],
      "default": "active"
    },
    "label": {
      "type": "string"
    },
    "location_address": {
      "type": "string"
    },
    "travel_minutes": {
      "type": "number"
    },
    "is_publicly_bookable": {
      "type": "boolean",
      "default": false
    },
    "created_by_role": {
      "type": "string"
    },
    "last_changed_by": {
      "type": "string"
    },
    "last_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string"
    },
    "google_calendar_event_id": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    }
  }
}
