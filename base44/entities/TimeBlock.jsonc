{
  "name": "TimeBlock",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "booking",
        "travel",
        "prep",
        "wrap",
        "manual_block"
      ],
      "default": "booking"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "provider"
          }
        }
      ]
    }
  }
}